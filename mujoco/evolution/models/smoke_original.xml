<mujoco 
        model="dawg" >
        <option
        timestep= "0.0025"
        gravity= "0 0 -9.81"
        />
    <worldbody>
        <light pos="0 -2 4" dir="0 0 -1"/>
        <geom name="ground" type="plane" size="5 5 0.1" friction="1 0 0"/>
        
        <body name="torso" pos="0 0 0.2">
            <freejoint name="root"/>
            <geom type="box" size="0.3 0.15 0.1" mass ="5" rgba="0.7 0.5 0.3 1"/> 

            <body name="frontleft" pos="-0.3 0.15 0.1">
                <joint name="frontlefthip" type="hinge" axis="1 0 0" 
                range="-0.52 0.52"/>
                <geom name="frontleftthigh" type="box" size="0.05 0.05 0.15" 
                mass="1" pos="0 0 -0.15" rgba="0.4 0.6 0.8 1"/>

                <body name="frontleftshin" pos="0 0 -0.3">
                    <joint name="frontleftknee" type="hinge" axis="1 0 0" 
                    range="-2 0"/>
                    <geom name="frontleftshin" type="box" size="0.05 0.05 0.15" 
                    mass="1" pos="0 0 -0.15" rgba="0.4 0.6 0.8 1"/>
                </body>
            </body>

             <body name="frontright" pos="-0.3 -0.15 0.1">
                <joint name="frontrighthip" type="hinge" axis="1 0 0" 
                range="-0.52 0.52"/>
                <geom name="frontrightthigh" type="box" size="0.05 0.05 0.15" 
                mass="1" pos="0 0 -0.15" rgba="0.4 0.6 0.8 1"/>

                <body name="frontrightshin" pos="0 0 -0.3">
                    <joint name="frontrightknee" type="hinge" axis="1 0 0" 
                    range="-2 0"/>
                    <geom name="frontrightshin" type="box" size="0.05 0.05 0.15" 
                    mass="1" pos="0 0 -0.15" rgba="0.4 0.6 0.8 1"/>
                </body>
            </body>


             <body name="backleft" pos="0.3 0.15 0.1">
                <joint name="backlefthip" type="hinge" axis="1 0 0" 
                range="-0.52 0.52"/>
                <geom name="backleftthigh" type="box" size="0.05 0.05 0.15" 
                mass="1" pos="0 0 -0.15" rgba="0.4 0.6 0.8 1"/>

                <body name="backleftshin" pos="0 0 -0.3">
                    <joint name="backleftknee" type="hinge" axis="1 0 0" 
                    range="-2 0"/>
                    <geom name="backleftshin" type="box" size="0.05 0.05 0.15" 
                    mass="1" pos="0 0 -0.15" rgba="0.4 0.6 0.8 1"/>
                </body>
            </body>


             <body name="backright" pos="0.3 -0.15 0.1">
                <joint name="backrighthip" type="hinge" axis="1 0 0" 
                range="-0.52 0.52"/>
                <geom name="backrightthigh" type="box" size="0.05 0.05 0.15" 
                mass="1" pos="0 0 -0.15" rgba="0.4 0.6 0.8 1"/>

                <body name="backrightshin" pos="0 0 -0.3">
                    <joint name="backrightknee" type="hinge" axis="1 0 0" 
                    range="-2 0"/>
                    <geom name="backrightshin" type="box" size="0.05 0.05 0.15" 
                    mass="1" pos="0 0 -0.15" rgba="0.4 0.6 0.8 1"/>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <motor name= "frontleftmotor"  joint="frontlefthip"  gear = "100"/>
        <motor name= "frontleftkneemotor"  joint="frontleftknee"  gear = "100"/>
        <motor name= "frontrightmotor" joint="frontrighthip" gear = "100"/>
        <motor name= "frontrightkneemotor" joint="frontrightknee" gear = "100"/>
        <motor name= "backleftmotor"   joint="backlefthip"   gear = "100"/>
        <motor name= "backleftkneemotor"   joint="backleftknee"   gear = "100"/>
        <motor name= "backrightmotor"  joint="backrighthip"  gear = "100"/>
        <motor name= "backrightkneemotor"  joint="backrightknee"  gear = "100"/>
    </actuator>
</mujoco>
